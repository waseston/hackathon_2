{
  "manifest_version": 3,
  "name": "Wattch Receipt — what your screen time costs",
  "short_name": "Wattch Receipt",
  "version": "1.0.0",
  "description": "Your day online as a receipt: minutes in the browser and on AI, and the energy, CO2 and water behind it. Everything stays on your laptop.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Wattch Receipt",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "src/dashboard/dashboard.html#settings",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "idle",
    "alarms",
    "notifications",
    "webRequest"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://www.perplexity.ai/*",
    "https://chat.deepseek.com/*",
    "https://grok.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://aistudio.google.com/*",
        "https://notebooklm.google.com/*",
        "https://claude.ai/*",
        "https://copilot.microsoft.com/*",
        "https://www.perplexity.ai/*",
        "https://chat.mistral.ai/*",
        "https://chat.deepseek.com/*",
        "https://grok.com/*",
        "https://www.meta.ai/*",
        "https://poe.com/*"
      ],
      "js": [
        "src/content/ai-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
